# Entornos virtuales
venv/
.venv/
env/

# Configuración con secretos — NUNCA versionar
config.yaml
.env
.env.*

# Composer auth (tokens de Packagist / GitHub privados)
auth.json

# Node / npm / Yarn tokens
.npmrc
.yarnrc
.yarnrc.yml

# Google / Firebase
service_account.json
google-services.json
google-credentials.json
GoogleService-Info.plist

# Infraestructura
*.tfstate
*.tfstate.backup
*.tfvars

# Auth helpers
.netrc
.htpasswd
.sentryclirc

# Índice de proyectos local — es específico de cada máquina
index.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.egg

# Logs y cache
*.log
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor
.vscode/*
!.vscode/tasks.json
.idea/
.gemini/

# Claude Code — configuración local de sesión (rutas de máquina, permisos)
.claude/

# Documento de trabajo interno para Codex — no es documentación pública
docs/codex-context.md

# MCP config local — contiene paths absolutos específicos de cada máquina
# Usar .mcp.json.example como referencia para crear el tuyo
.mcp.json

# Codex local - configuracion MCP especifica de esta maquina
.codex/config.toml
.codex/mcp-debug.log

# Orchestrator local - metadata especifica de esta maquina
.orchestrator/

# OS
.DS_Store
Thumbs.db

# DB runtime — datos locales, no se versionan
*.db
*.sqlite3
